        withMode(mode): { spec+: { operationTemplate+: { spec+: { mode: mode } } } },
        '#withPipeline':: d.fn(help='"Pipeline is a list of operation function steps that will be used when\\nthis operation runs."', args=[d.arg(name='pipeline', type=d.T.array)]),
        withPipeline(pipeline): { spec+: { operationTemplate+: { spec+: { pipeline: if std.isArray(v=pipeline) then pipeline else [pipeline] } } } },
        '#withPipelineMixin':: d.fn(help='"Pipeline is a list of operation function steps that will be used when\\nthis operation runs."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='pipeline', type=d.T.array)]),
        withPipelineMixin(pipeline): { spec+: { operationTemplate+: { spec+: { pipeline+: if std.isArray(v=pipeline) then pipeline else [pipeline] } } } },
        '#withRetryLimit':: d.fn(help='"RetryLimit configures how many times the operation may fail. When the\\nfailure limit is exceeded, the operation will not be retried."', args=[d.arg(name='retryLimit', type=d.T.integer)]),
        withRetryLimit(retryLimit): { spec+: { operationTemplate+: { spec+: { retryLimit: retryLimit } } } },
