      withMatchLabels(matchLabels): { spec+: { watch+: { matchLabels: matchLabels } } },
      '#withMatchLabelsMixin':: d.fn(help='"MatchLabels selects resources by label. If empty, all resources of the\\nspecified kind are watched."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='matchLabels', type=d.T.object)]),
      withMatchLabelsMixin(matchLabels): { spec+: { watch+: { matchLabels+: matchLabels } } },
