    withConcurrencyPolicy(concurrencyPolicy): { spec+: { concurrencyPolicy: concurrencyPolicy } },
    '#withFailedHistoryLimit':: d.fn(help='"FailedHistoryLimit is the number of failed Operations to retain."', args=[d.arg(name='failedHistoryLimit', type=d.T.integer)]),
    withFailedHistoryLimit(failedHistoryLimit): { spec+: { failedHistoryLimit: failedHistoryLimit } },
    '#withSuccessfulHistoryLimit':: d.fn(help='"SuccessfulHistoryLimit is the number of successful Operations to retain."', args=[d.arg(name='successfulHistoryLimit', type=d.T.integer)]),
