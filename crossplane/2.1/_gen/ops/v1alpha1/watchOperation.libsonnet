      withApiVersion(apiVersion): { spec+: { watch+: { apiVersion: apiVersion } } },
      '#withKind':: d.fn(help='"Kind of the resource to watch."', args=[d.arg(name='kind', type=d.T.string)]),
      withKind(kind): { spec+: { watch+: { kind: kind } } },
